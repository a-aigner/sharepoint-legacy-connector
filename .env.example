# ---- Connection ----
# Root URL of the SharePoint web application or site collection. No trailing slash.
SP_BASE_URL=http://sharepoint.intern.example.de

# integrated | ntlm | basic | anonymous
#
# RECOMMENDED: integrated. Authenticates as the identity the process is already
# running under (Windows SSPI, or a Kerberos ticket). No password is stored, read
# or held in memory, so there is nothing to leak into a log or a backup.
#   pip install 'spconnect[windows]'    # domain-joined Windows
#   pip install 'spconnect[kerberos]'   # elsewhere, after kinit
# Then run the crawl AS the service account and leave SP_USERNAME/SP_PASSWORD blank.
SP_AUTH_MODE=integrated

# Only needed for SP_AUTH_MODE=ntlm or basic. Leave blank for integrated.
# For NTLM use DOMAIN\username. Write the backslash ONCE — do not double it.
# CONTOSO\\svc_extract would be read literally, with two backslashes, and fail auth.
SP_USERNAME=
# Quote the password only if it has leading/trailing spaces. # and $ are safe unquoted.
SP_PASSWORD=

# ---- Transport quirks (legacy servers) ----
# Old IIS may only offer TLS 1.0/1.1 with weak ciphers that modern OpenSSL rejects.
SP_ALLOW_LEGACY_TLS=true
SP_VERIFY_SSL=false
SP_TIMEOUT_SECONDS=120
SP_MAX_RETRIES=5
SP_BACKOFF_BASE_SECONDS=2

# ---- Politeness: this server is 20 years old. Be gentle. ----
SP_CONCURRENCY=2
SP_REQUESTS_PER_SECOND=3

# ---- Crawl scope ----
# Comma-separated. Empty = all.
SP_INCLUDE_WEBS=
SP_EXCLUDE_WEBS=
SP_INCLUDE_LISTS=
SP_EXCLUDE_LISTS=
SP_INCLUDE_HIDDEN_LISTS=false
SP_INCLUDE_DOCUMENT_LIBRARIES=true

# ---- Paging ----
SP_PAGE_SIZE=200

# ---- Files ----
SP_DOWNLOAD_FILES=true
SP_MAX_FILE_MB=100
SP_SKIP_EXTENSIONS=.exe,.dll,.msi,.iso

# ---- Output ----
SP_LANDING_DIR=./landing
SP_STATE_FILE=./landing/_state.json

# ---- Logging ----
SP_LOG_LEVEL=INFO
SP_LOG_FORMAT=console        # console | json

# ---- Tests ----
# Set to 1 to enable tests that hit the real server.
SP_LIVE_TESTS=0

# ---- Item source (SharePoint 2010+) ----
# soap  = Lists.asmx GetListItems (default; works on every build 2003->2016)
# odata = _vti_bin/ListData.svc (SharePoint 2010+ only, typed JSON values)
# Web discovery, field schema and deletes are ALWAYS SOAP — OData has no
# equivalent. Lists with no REST entity set fall back to SOAP automatically.
SP_API_MODE=soap
SP_ODATA_EXPAND_LOOKUPS=true

# ---- Verbosity ----
# Also settable per-run: -v (debug), -vv (debug + body capture), -q (no narration).
# Bodies are written to SP_TRACE_FILE at mode 0600, never to the log stream.
SP_LOG_BODIES=false
# SP_TRACE_FILE=./landing/_trace.log
SP_LOG_BODY_CHARS=2000
SP_SHOW_STEPS=true
